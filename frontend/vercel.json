{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/collections",
      "has": [
        {
          "type": "query",
          "key": "category",
          "value": "^necklaces?$"
        }
      ],
      "destination": "/collections/necklaces",
      "permanent": true
    },
    {
      "source": "/collections",
      "has": [
        {
          "type": "query",
          "key": "category",
          "value": "^earrings?$"
        }
      ],
      "destination": "/collections/earrings",
      "permanent": true
    },
    {
      "source": "/collections",
      "has": [
        {
          "type": "query",
          "key": "category",
          "value": "^rings?$"
        }
      ],
      "destination": "/collections/rings",
      "permanent": true
    },
    {
      "source": "/collections",
      "has": [
        {
          "type": "query",
          "key": "category",
          "value": "^bracelets?$"
        }
      ],
      "destination": "/collections/bracelets",
      "permanent": true
    },
    {
      "source": "/collections",
      "has": [
        {
          "type": "query",
          "key": "category",
          "value": "^bangles?$"
        }
      ],
      "destination": "/collections/bangles",
      "permanent": true
    },
    {
      "source": "/admin-login",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/shipping-returns",
      "destination": "/shipping-delivery",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(cart|checkout|wishlist|search|login|admin|reset-password)",
      "destination": "/app.html"
    },
    {
      "source": "/(auth|account|admin|pay|order-confirmation|orders|product|collections)/:path*",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(media|images|og)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml|meta-catalog.csv|llms.txt|llms-full.txt|feeds/google-merchant.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://checkout.razorpay.com\" \"https://api.razorpay.com\")"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}
