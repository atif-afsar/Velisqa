# Velisqa API — SERVER ONLY. Copy to backend/.env on the VPS (chmod 600).
# Never put these in Vercel / VITE_* variables or commit real values.

NODE_ENV=production
PORT=5000
HOST=127.0.0.1
# Express trusts X-Forwarded-* only from Nginx on loopback.
TRUST_PROXY=loopback
PUBLIC_API_ORIGIN=https://api.velisqa.com
FRONTEND_ORIGIN=https://www.velisqa.com
# Extra exact origins allowed to call the API with cookies (comma separated).
CORS_ALLOWED_ORIGINS=https://velisqa.com

# MongoDB replica set (transactions are required for checkout/payments).
MONGODB_URI=mongodb://velisqa_app:REPLACE_DB_PASSWORD@127.0.0.1:27017/velisqa?authSource=velisqa&replicaSet=rs0
MONGODB_DB_NAME=velisqa

# 32+ random characters each: `openssl rand -base64 48`
SESSION_SECRET=
CSRF_SECRET=
# Encrypts guest order links at rest. NEVER rotate without re-encrypting orders (old links would stop showing in admin).
ORDER_TOKEN_SECRET=
COOKIE_NAME=velisqa.sid
# Leave empty for a host-only cookie on api.velisqa.com (recommended).
COOKIE_DOMAIN=
SESSION_TTL_DAYS=14

# Google OAuth (Google Cloud console → Authorized redirect URI must equal GOOGLE_REDIRECT_URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.velisqa.com/api/v1/auth/google/callback

# Razorpay (test keys on staging; live keys only after sign-off)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# NimbusPost (same meaning as the old Edge Function secrets)
NIMBUSPOST_API_MODE=v2
# Book a shipment automatically after a verified online payment (old behaviour). Set false to ship manually.
NIMBUSPOST_AUTO_SHIP=true
NIMBUSPOST_API_KEY=
NIMBUSPOST_API_SECRET=
NIMBUSPOST_EMAIL=
NIMBUSPOST_PASSWORD=
NIMBUSPOST_WAREHOUSE_ID=
NIMBUSPOST_DEFAULT_STATE=UP
NIMBUSPOST_PICKUP_NAME=VELISQA
NIMBUSPOST_PICKUP_PHONE=
NIMBUSPOST_PICKUP_ADDRESS=
NIMBUSPOST_PICKUP_CITY=Aligarh
NIMBUSPOST_PICKUP_STATE=UP
NIMBUSPOST_PICKUP_PINCODE=
NIMBUSPOST_PACKAGE_WEIGHT_GRAMS=500
NIMBUSPOST_PACKAGE_LENGTH_CM=10
NIMBUSPOST_PACKAGE_WIDTH_CM=10
NIMBUSPOST_PACKAGE_HEIGHT_CM=5
NIMBUSPOST_CREATE_SHIPMENT_URL=
NIMBUSPOST_CANCEL_SHIPMENT_URL=
# Sent by NimbusPost in the X-Webhook-Secret (or X-Velisqa-Webhook-Secret) header.
NIMBUSPOST_WEBHOOK_SECRET=
# Only for a transition period if NimbusPost can only call ?secret=... URLs.
NIMBUSPOST_WEBHOOK_ALLOW_QUERY_SECRET=false

# Cloudinary signed uploads (products: admins, reviews: signed-in customers)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Meta Conversions API (optional)
META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
META_GRAPH_API_VERSION=v23.0
META_TEST_EVENT_CODE=

# SMTP for password-reset emails (Hostinger mail works: smtp.hostinger.com:465)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Velisqa <no-reply@velisqa.com>

# AI product drafting from photos (admin bulk upload). Optional.
ANTHROPIC_API_KEY=
# Where self-hosted images are stored (hero banners, uploads when Cloudinary is not set). Default: backend/uploads
MEDIA_DIR=/srv/velisqa/media

LOG_LEVEL=info

# ── Migration scripts only (never read by the running API) ──
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
