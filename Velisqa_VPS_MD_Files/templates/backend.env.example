# SERVER ONLY. Do not place in Vercel or commit production values.
NODE_ENV=production
PORT=5000
HOST=127.0.0.1
PUBLIC_API_ORIGIN=https://api.velisqa.com
FRONTEND_ORIGIN=https://www.velisqa.com
CORS_ALLOWED_ORIGINS=https://www.velisqa.com,https://velisqa.com

# Persistent DB. Transactions require replica set; REPLACE secrets securely.
MONGODB_URI=mongodb://APP_DB_USER:REPLACE_DB_PASSWORD@127.0.0.1:27017/velisqa?authSource=velisqa&replicaSet=rs0
MONGODB_DB_NAME=velisqa

# Server-issued, secure HttpOnly session + CSRF
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SERVER_SECRET
CSRF_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
COOKIE_NAME=velisqa.sid
SESSION_TTL_DAYS=14

# Google OAuth server application
GOOGLE_CLIENT_ID=REPLACE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://api.velisqa.com/api/v1/auth/google/callback

# Razorpay test credentials on staging, live credentials only after sign-off
RAZORPAY_KEY_ID=REPLACE_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_RAZORPAY_WEBHOOK_SECRET

# NimbusPost (source: supabase/functions/_shared/nimbuspost.ts)
NIMBUSPOST_API_MODE=REPLACE_MODE
NIMBUSPOST_EMAIL=REPLACE_EMAIL_IF_LOGIN_MODE
NIMBUSPOST_PASSWORD=REPLACE_PASSWORD_IF_LOGIN_MODE
NIMBUSPOST_API_TOKEN=REPLACE_TOKEN_IF_TOKEN_MODE
NIMBUSPOST_API_KEY=REPLACE_API_KEY_IF_REQUIRED
NIMBUSPOST_API_SECRET=REPLACE_API_SECRET_IF_REQUIRED
NIMBUSPOST_CREATE_SHIPMENT_URL=
NIMBUSPOST_CANCEL_SHIPMENT_URL=
NIMBUSPOST_WEBHOOK_SECRET=REPLACE_WEBHOOK_SECRET
NIMBUSPOST_WAREHOUSE_ID=REPLACE_WAREHOUSE_ID
NIMBUSPOST_PICKUP_NAME=REPLACE_PICKUP_NAME
NIMBUSPOST_PICKUP_PHONE=REPLACE_PICKUP_PHONE
NIMBUSPOST_PICKUP_ADDRESS=REPLACE_PICKUP_ADDRESS
NIMBUSPOST_PICKUP_CITY=REPLACE_PICKUP_CITY
NIMBUSPOST_PICKUP_STATE=REPLACE_PICKUP_STATE
NIMBUSPOST_PICKUP_PINCODE=REPLACE_6_DIGIT_PINCODE
NIMBUSPOST_PACKAGE_WEIGHT_GRAMS=REPLACE_WEIGHT
NIMBUSPOST_PACKAGE_LENGTH_CM=REPLACE_LENGTH
NIMBUSPOST_PACKAGE_WIDTH_CM=REPLACE_WIDTH
NIMBUSPOST_PACKAGE_HEIGHT_CM=REPLACE_HEIGHT

# Product/review uploads; allow server-side signed uploads, not API secret in Vite
CLOUDINARY_CLOUD_NAME=REPLACE_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_CLOUDINARY_KEY
CLOUDINARY_API_SECRET=REPLACE_CLOUDINARY_SECRET

# Server-side analytics (optional if project config uses it)
META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
META_GRAPH_API_VERSION=v24.0
META_TEST_EVENT_CODE=

# Email provider to be implemented, avoid client-side leaks
EMAIL_FROM=REPLACE_VERIFIED_SENDER
EMAIL_PROVIDER_API_KEY=REPLACE_EMAIL_SECRET

# NEVER enable fake DB in production
DB_ADAPTER=mongodb
# Only migration scripts should read the old Supabase service credentials
# SUPABASE_MIGRATION_URL=
# SUPABASE_MIGRATION_SERVICE_ROLE_KEY=
